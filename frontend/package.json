{
  "name": "frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint:check && npm run typecheck",
    "lint:check": "eslint \"./src/**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "lint:fix": "eslint \"./src/**/*.{js,jsx,mjs,cjs,ts,tsx}\" --fix",
    "format": "prettier --write './src/**/*'",
    "format:check": "prettier --check './src/**/*' --debug-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
}
