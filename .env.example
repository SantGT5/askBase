# Copy to .env and fill in: cp .env.example .env
# Docker Compose reads .env automatically.

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=5001
FRONTEND_PORT=5173
# Only used when running Flask outside Docker; docker-compose.yml points the container at host "db"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Signs login tokens. Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# The AI that writes answers: claude | deepseek | glm
LLM_PROVIDER=glm
# Optional, empty = provider default (claude-opus-5-5 | deepseek-flash | glm-4.7-flash)
LLM_MODEL=
# API key for the chosen provider:
#   claude:   https://platform.claude.com/settings/keys (paid)
#   deepseek: https://platform.deepseek.com/api_keys (paid, cheap)
#   glm:      https://z.ai, API Keys page (glm-4.7-flash is free)
LLM_API_KEY=
